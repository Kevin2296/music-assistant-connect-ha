{
  "manifest_version": 3,
  "name": "Music Connect tijdelijke cookiehulp",
  "version": "0.1.0",
  "description": "Leest providergegevens alleen wanneer je in je eigen HA-app op ophalen klikt.",
  "permissions": ["cookies", "webRequest", "tabs"],
  "host_permissions": ["https://*.youtube.com/*", "https://*.soundcloud.com/*", "https://*.deezer.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "start.js"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*"}
}
